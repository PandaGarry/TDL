; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; TDL — Godot 4.7 project.
; Название, жанр и мир — рабочие, определяются в docs/.

config_version=5

[application]

config/name="TDL"
config/description="TDL — рабочее название. GDD v1.0 Core Baseline и документация мира находятся в папке docs/."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.043, 0.063, 1)
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoloads/event_bus.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
SettingsManager="*res://scripts/autoloads/settings_manager.gd"
SaveSystem="*res://scripts/autoloads/save_system.gd"
SceneLoader="*res://scripts/autoloads/scene_loader.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"

[debug]

gdscript/warnings/enable=true
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

