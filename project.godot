[layer_names]

2d_physics/layer_1="Terrain"
2d_physics/layer_2="Bodies"
2d_physics/layer_3="Structures"
2d_physics/layer_4="Items"
2d_physics/layer_5="Interactables"
2d_physics/layer_6="Hazards"
2d_physics/layer_7="Sensors"
2d_physics/layer_8="Projectiles"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
environment/defaults/default_clear_color=Color(0.043, 0.043, 0.063, 1)
