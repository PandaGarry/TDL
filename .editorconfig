root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript в Godot по умолчанию использует табы
[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,cfg,import}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
