extends Node
## EventBus — глобальная шина сигналов.
##
## Используется только для событий, которые действительно касаются
## всей игры (старт, пауза, смена сцены, сохранения). Локальные связи
## внутри сцены делай обычными сигналами родитель <-> потомок,
## иначе шина превратится в нечитаемую свалку.
##
## Новые сигналы добавляй сюда сгруппированно по доменам и с комментарием,
## кто испускает сигнал и кто на него обычно подписан.

# --- Игровой цикл -------------------------------------------------------

## GameManager -> все: началась новая игровая сессия.
signal game_started

## GameManager -> все: игра поставлена/снята с паузы.
signal game_paused(is_paused: bool)

## GameManager -> все: игрок вернулся в главное меню.
signal returned_to_main_menu

# --- Сцены ---------------------------------------------------------------

## SceneLoader -> UI: запрошена смена сцены (можно показать загрузку).
signal scene_change_requested(path: String)

## SceneLoader -> все: новая сцена уже активна.
signal scene_changed(path: String)

# --- Сохранения ----------------------------------------------------------

## SaveSystem -> UI: сохранение завершено успешно.
signal save_completed(slot: int)

## SaveSystem -> UI/игровой мир: сохранение загружено.
signal load_completed(slot: int)

# --- Настройки -----------------------------------------------------------

## SettingsManager -> все: настройки изменились и уже применены.
signal settings_changed
